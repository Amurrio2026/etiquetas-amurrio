# ---------------------------------------------------------------------------
# Copiar este archivo a ".env.local" y completar. Mientras alguna variable
# no este definida, la app funciona igual con datos de prueba (ver lib/mock)
# para poder probar el flujo completo sin depender de credenciales reales.
# ---------------------------------------------------------------------------

# Base de datos real (bazar_analytics), usuario de SOLO LECTURA.
# Si se deja vacio, se usan articulos y sucursales de ejemplo (lib/mock).
DATABASE_URL=

# Resend (envio de PDF por email). Conseguir en https://resend.com
# Si se deja vacio, el envio queda simulado: se loguea en consola en vez de mandarse.
# OJO: el dominio verificado en Resend (2026-09-11) es "etiquetas.amurrio.com.ar"
# (subdominio, para no tocar el mail real de la empresa en amurrio.com.ar) -- el
# remitente tiene que ser una direccion de ESE dominio exacto, sino Resend rechaza el envio.
RESEND_API_KEY=
RESEND_FROM="Etiquetas Amurrio <etiquetas@etiquetas.amurrio.com.ar>"

# Modo prueba: mientras sea "true", TODO envio de email va a TEST_EMAIL_TO
# sin importar la sucursal elegida. Pasar a "false" recién cuando este todo
# validado y confirmado con Lucila.
TEST_MODE=true
TEST_EMAIL_TO=operaciones@amurrio.com.ar

# Historial de pedidos en Google Sheets (planilla "APP DE ETIQUETAS" / hoja "Historial").
# GOOGLE_SHEETS_ID: el ID en la URL de la planilla (entre /d/ y /edit).
# GOOGLE_SERVICE_ACCOUNT_JSON: el contenido completo del JSON de la cuenta de
# servicio de Google (en una sola linea), con permiso de Editor sobre la planilla.
# Si se dejan vacios, el historial se guarda en un archivo local (lib/historial/historial.local.json)
# para no perder pedidos mientras se configura Google.
GOOGLE_SHEETS_ID=10519a3zdoL14BH1nvgwxhL58KihAWEkPmYC-rcBWeHo
GOOGLE_SERVICE_ACCOUNT_JSON=
